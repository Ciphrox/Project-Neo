NEO_SESSION="NEO_<session_string>"  # Base64 encoded session string
TRIGGERS="^[.!;]"                   # Regular expression for command triggers
BOT_NAME="Neo"                      # Name of the bot
DEFAULT_PREFIX="."                  # Default command prefix
ENVIRONMENT="PROD"                  # Deployment environment (e.g., PROD, DEV) (enables/disables logger)
ACCESS_MODE="PUBLIC"                # Bot access mode: PUBLIC or PRIVATE
SUDO="1234567890, 0987654321"       # Comma-separated list of SUDO user IDs